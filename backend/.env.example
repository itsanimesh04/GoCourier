# Server Configuration
NODE_ENV=development
PORT=8000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/go_courier_service

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-16-characters
JWT_EXPIRES_IN=7d

# OTP Configuration
OTP_TTL_MINUTES=10
OTP_LENGTH=4

# App Timezone
APP_TIME_ZONE=Asia/Kolkata

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# Cookie Configuration (optional - defaults provided)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Frontend origins (CORS)
ADMIN_ORIGIN=http://localhost:5174
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://gocourierservice.com,https://admin.gocourierservice.com

# AWS S3 (admin image uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
S3_BUCKET=your-bucket-name
S3_PUBLIC_BASE_URL=https://your-bucket-name.s3.ap-south-1.amazonaws.com